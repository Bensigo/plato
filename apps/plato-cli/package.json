{
  "name": "@bensigo/plato-cli",
  "version": "0.1.4",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "scripts/postinstall.mjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "plato": "dist/src/cli.js",
    "plato-mcp": "dist/src/mcp.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "echo 'plato cli dev not wired yet'",
    "lint": "oxlint .",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build",
    "smoke": "pnpm build && node dist/src/cli.js smoke",
    "test": "vitest run --dir test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@bensigo/plato-codex-runner": "workspace:*",
    "@bensigo/plato-orchestration": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "oxlint": "^1.60.0",
    "vitest": "^4.1.4"
  }
}
