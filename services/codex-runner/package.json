{
  "name": "@bensigo/plato-codex-runner",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "codex-runner": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "echo 'codex-runner dev not wired yet'",
    "lint": "oxlint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "oxlint": "^1.60.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@bensigo/plato-db": "workspace:*",
    "@bensigo/plato-config": "workspace:*",
    "@bensigo/plato-orchestration": "workspace:*",
    "@openai/codex-sdk": "^0.123.0"
  }
}
